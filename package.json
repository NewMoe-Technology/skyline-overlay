{
  "name": "skyline-overlay",
  "version": "4.6.0",
  "private": true,
  "description": "A modern customizable horizon FFXIV miniparse overlay.",
  "license": "Apache-2.0",
  "author": "DSRKafuU <dsrkafuu@outlook.com> (https://dsrkafuu.net)",
  "type": "module",
  "scripts": {
    "oxfmt": "oxfmt",
    "oxlint": "oxlint",
    "typecheck": "tsc",
    "bundle": "bun --bun vite build",
    "serve": "bun --bun vite",
    "script:genIconIdx": "bun \"./scripts/genIconIdx.ts\"",
    "script:genMeta": "bun \"./scripts/genMeta.ts\"",
    "script:removeTrash": "bun \"./scripts/removeTrash.ts\"",
    "build": "cross-env NODE_ENV=production run-s script:genIconIdx script:genMeta typecheck oxlint bundle script:removeTrash",
    "analyze": "cross-env NODE_ENV=production ENABLE_ANALYZER=1 run-s script:genIconIdx script:genMeta bundle",
    "dev": "cross-env NODE_ENV=development VITE_GA_ID=TEST run-s script:genIconIdx script:genMeta serve"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "normalize.css": "^8.0.1",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "stable-hash": "^0.0.6",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chalk": "^6.0.0",
    "cross-env": "^10.1.0",
    "glob": "^13.0.6",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "sass": "^1.104.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "versionCode": "Krile Baldesion"
}
